{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "node artifacts/corca-website/scripts/check-static.mjs",
    "typecheck": "node artifacts/corca-website/scripts/check-static.mjs && pnpm --filter @workspace/mockup-sandbox run typecheck",
    "test": "node artifacts/corca-website/scripts/check-static.mjs",
    "test:browser": "node scripts/verify-corcastatic.mjs"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
